<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hdjd_background"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="@dimen/error_content_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="@dimen/error_icon_size"
            android:layout_height="@dimen/error_icon_size"
            android:contentDescription="@string/error_icon_description"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cloud_off" />

        <TextView
            android:id="@+id/error_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/error_gap"
            android:gravity="center"
            android:textColor="@color/hdjd_on_background"
            android:textSize="@dimen/error_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/hdjd_muted"
            android:textSize="@dimen/error_body_size" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/error_button_height"
            android:layout_marginTop="@dimen/error_gap"
            android:background="@drawable/bg_button_primary"
            android:focusable="true"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="@color/hdjd_background"
            android:textSize="@dimen/error_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</FrameLayout>
